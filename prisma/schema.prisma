// Datamodel voor het voorraadbeheer van een tweewielerzaak.
// Bron: docs/SPEC.md §4 (datamodel) en §3 (architectuurregels, bindend).
// Veld- en modelnamen zijn Engels; de UI toont Nederlandse labels.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connectie voor de applicatie; DIRECT_URL is de niet-pooled connectie
  // die Prisma gebruikt voor migraties (nodig bij Neon / Vercel Postgres).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Vast lijstje in v1 (geen eigen CRUD). De UI toont Nederlandse labels.
enum Category {
  SCOOTER_PART
  MOTOR_PART
  EBIKE_PART
  MOBILITY_PART
  HELMET
  ACCESSORY
  /// Verbruiksartikelen: olie, vet, schoonmaakmiddelen.
  CONSUMABLE
  OTHER
}

/// COUNTER = verkoop over de balie.
/// WORKSHOP = voorraadverbruik in de eigen werkplaats (onderdeel verdwijnt in een
/// reparatie). Verlaagt de voorraad op dezelfde manier en telt mee in de bestsellers,
/// maar wordt in rapportages apart uitgesplitst van de balieomzet.
enum SaleChannel {
  COUNTER
  WORKSHOP
}

/// Waarom een voorraadmutatie plaatsvond (T17).
///
/// DELIVERY    = levering van de leverancier binnengeboekt.
/// CORRECTION  = handmatige correctie (verkeerd geboekt, breuk, retour).
/// COUNT       = uitkomst van een fysieke telling; de voorraad is op het gestelde
///               aantal gezet, het verschil staat in `delta`.
/// SALE        = verkoop over de balie (hoort bij een `Sale` met channel COUNTER).
/// WORKSHOP    = verbruik in de eigen werkplaats (hoort bij een `Sale` met channel
///               WORKSHOP). Bewust een eigen reden naast SALE: het grootboek moet
///               zonder join naar `Sale` te lezen zijn.
/// INITIAL     = beginstand bij het aanleggen van het onderdeel.
enum StockMutationReason {
  DELIVERY
  CORRECTION
  COUNT
  SALE
  WORKSHOP
  INITIAL
}

// ---------------------------------------------------------------------------
// Modellen
// ---------------------------------------------------------------------------

/// Merk, bv. Vespa, Piaggio, Kymco, NIU, Super73.
model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parts Part[]
}

/// Leverancier. Soft delete via archivedAt (SPEC §3 regel 4).
model Supplier {
  id            String    @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  /// Meerregelig adres.
  address       String?
  notes         String?
  /// Soft delete: gevuld = gearchiveerd, verborgen in overzichten.
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  parts Part[]

  @@index([archivedAt])
}

/// Onderdeel op voorraad.
model Part {
  id String @id @default(cuid())

  name String

  /// Merk is OPTIONEEL: universele onderdelen (olie, remblokken, kabels, lampjes)
  /// horen bij geen enkel merk. De werkplaats onderhoudt bovendien merken die de
  /// winkel zelf niet verkoopt.
  brandId String?
  /// onDelete: SetNull — een merk verwijderen mag het onderdeel niet meeslepen; het
  /// onderdeel wordt dan simpelweg "universeel". Past bij de optionele relatie.
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Verplicht; vast lijstje in v1.
  category Category

  /// Intern artikelnummer, verplicht en uniek.
  sku     String  @unique
  /// EAN/QR, optioneel. In Postgres zijn meerdere NULL-waarden toegestaan binnen een
  /// unique index, dus "uniek indien gevuld" werkt zonder extra constraint.
  barcode String? @unique

  /// Het artikelnummer dat de leverancier of fabrikant op de verpakking of het label
  /// drukt. Bewust NIET uniek: twee leveranciers kunnen hetzelfde nummer gebruiken,
  /// en hetzelfde nummer kan op meerdere varianten staan. Geïndexeerd omdat T20
  /// hierop matcht bij het scannen van een label.
  supplierArticleNumber String?

  /// Inkoopprijs EXCLUSIEF btw: leveranciersfacturen zijn excl. btw
  /// (SPEC §3 regel 0, herzien in v2.0).
  purchasePriceExcl Decimal @db.Decimal(10, 2)
  /// Verkoopprijs INCLUSIEF btw: dat is het bedrag dat de winkel vaststelt en de
  /// klant betaalt, en het moet exact blijven. Excl. opslaan in twee decimalen
  /// verliest centen bij het terugrekenen (€10,00 incl. bij 21% → 8,264462… →
  /// opgeslagen 8,26 → terug €9,99). Het excl.-bedrag wordt afgeleid met
  /// `salePriceIncl / (1 + vatRate / 100)`; marge en rapportages rekenen ALTIJD met
  /// dat excl.-bedrag, want btw is geen winst.
  ///
  /// De veldnaam draagt de betekenis (`Incl` / `Excl`), zodat het verwarren van de
  /// twee een compilerfout geeft in plaats van een stille rekenfout.
  salePriceIncl     Decimal @db.Decimal(10, 2)
  /// Btw-percentage per product (bv. 21.00), niet als fractie.
  vatRate           Decimal @default(21) @db.Decimal(5, 2)

  stockQuantity Int @default(0)
  /// Drempel voor de lage-voorraadmelding.
  minStock      Int @default(0)

  supplierId String?
  /// onDelete: SetNull — zie brand; het onderdeel blijft bestaan zonder leverancier.
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  description String?
  /// Vrij pasvormveld, bv. "Vespa Primavera 2016-2021, Sprint 125". Doorzoekbaar.
  fitsModels  String?
  /// Schaplocatie.
  location    String?

  /// Soft delete: gevuld = gearchiveerd. Verborgen in overzichten en niet
  /// selecteerbaar bij nieuwe verkoop, maar blijft zichtbaar in rapportages.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales          Sale[]
  stockMutations StockMutation[]

  @@index([brandId])
  @@index([supplierId])
  @@index([archivedAt])
  @@index([category])
  @@index([supplierArticleNumber])
}

/// Eén verkoop- of werkplaatsverbruikregel.
/// Verkoophistorie is onaantastbaar: prijzen worden hier historisch vastgelegd, zodat
/// de marge reconstrueerbaar blijft als de prijzen van het onderdeel later wijzigen
/// (SPEC §3 regel 3).
model Sale {
  id String @id @default(cuid())

  partId String
  /// onDelete: Restrict — verkoophistorie mag NOOIT verdwijnen (SPEC §3 regel 4).
  /// De database weigert daarom het hard verwijderen van een onderdeel dat in de
  /// verkoophistorie voorkomt; archiveren via Part.archivedAt is de enige weg.
  part   Part   @relation(fields: [partId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Altijd > 0; afgedwongen in de Zod-validatie, niet in de database.
  quantity Int

  /// Verkoopprijs per stuk INCLUSIEF btw op het moment van verkoop: exact het bedrag
  /// dat de klant betaalde (SPEC §3 regel 0, v2.0).
  salePriceInclAtSale     Decimal @db.Decimal(10, 2)
  /// Inkoopprijs per stuk EXCLUSIEF btw op het moment van verkoop.
  purchasePriceExclAtSale Decimal @db.Decimal(10, 2)
  /// Btw-tarief op moment van verkoop, zodat het excl.-bedrag — en daarmee de marge —
  /// reconstrueerbaar blijft, ook als het tarief van het onderdeel later wijzigt.
  vatRateAtSale           Decimal @db.Decimal(5, 2)

  channel SaleChannel

  /// Vrije verwijzing naar de werkorder. GEEN persoonsgegevens: geen klantnaam,
  /// geen kenteken (AVG).
  reference String?

  soldAt DateTime @default(now())
  note   String?

  @@index([partId])
  @@index([soldAt])
  @@index([channel])
}

/// Voorraadgrootboek: elke wijziging van `Part.stockQuantity` laat hier één regel
/// achter (T17). Onveranderlijk: een verkeerde mutatie wordt niet gewist of
/// bijgewerkt, maar tegengeboekt met een nieuwe regel (`CORRECTION`), zodat de
/// geschiedenis reconstrueerbaar blijft.
///
/// ### Waarom er GEEN "wie" wordt vastgelegd
/// De applicatie beveiligt zichzelf met één gedeeld wachtwoord (SPEC §F7) en heeft
/// geen gebruikersaccounts: iedereen aan de balie en in de werkplaats logt met
/// hetzelfde wachtwoord in. Er is dus geen identiteit die vast te leggen valt; een
/// veld `createdBy` zou onvermijdelijk leeg of onbetrouwbaar zijn en de suggestie
/// wekken dat mutaties herleidbaar zijn tot een persoon. Bovendien is een
/// persoonsgegeven zonder noodzaak niet gewenst (AVG, zie ook `Sale.reference`).
/// Vastgelegd worden daarom alleen WANNEER (`createdAt`), WAT (`delta`,
/// `quantityBefore`, `quantityAfter`) en WAAROM (`reason`, `note`, `saleId`).
model StockMutation {
  id String @id @default(cuid())

  partId String
  /// onDelete: Restrict — het grootboek mag NOOIT verdwijnen (SPEC §3 regel 4), dus
  /// de database weigert het hard verwijderen van een onderdeel met mutaties.
  /// Archiveren via `Part.archivedAt` is de enige weg.
  part   Part   @relation(fields: [partId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Verandering in stuks: negatief bij verkoop of verbruik, positief bij een
  /// levering. Mag niet 0 zijn (afgedwongen met een CHECK in de migratie).
  delta          Int
  /// Voorraadstand vóór deze mutatie.
  quantityBefore Int
  /// Voorraadstand ná deze mutatie; altijd `quantityBefore + delta`, expliciet
  /// opgeslagen zodat het grootboek zonder herrekenen te lezen is.
  quantityAfter  Int

  reason StockMutationReason
  /// Vrije toelichting, bv. "pakbon 2026-4471". GEEN persoonsgegevens (AVG).
  note   String?

  /// Gevuld als deze mutatie bij een verkoop of werkplaatsverbruik hoort. Bewust
  /// GEEN foreign key: het grootboek moet ook overeind blijven als een verkoopregel
  /// ooit gecorrigeerd wordt, en een verwijderde `Sale` mag de mutatie niet
  /// meeslepen.
  saleId String?

  createdAt DateTime @default(now())

  @@index([partId])
  @@index([createdAt])
  @@index([reason])
}
