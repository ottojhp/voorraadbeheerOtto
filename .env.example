# Postgres-connectiestring (pooled), zie docs/SPEC.md §6.
DATABASE_URL="postgresql://user:password@localhost:5432/voorraadbeheer?schema=public"

# Directe (niet-pooled) connectie, nodig voor Prisma-migraties (bv. bij Neon).
DIRECT_URL="postgresql://user:password@localhost:5432/voorraadbeheer?schema=public"

# Gedeeld wachtwoord voor de hele site (SPEC §F7). Verplicht, geen echte waarde hieronder.
APP_PASSWORD="wijzig-dit-wachtwoord"

# Sleutel voor het HMAC-ondertekenen van het sessiecookie. Verplicht, geen echte waarde hieronder.
SESSION_SECRET="wijzig-dit-in-een-lange-willekeurige-geheime-string"
